# ---------------------------------------------------------------------------
# Build outputs - regenerated by `docker compose run --rm build`
# ---------------------------------------------------------------------------
/.bin/
/logs/

# Local scratch space (downloads, experiments, throwaway venvs)
/.tmp/

# ---------------------------------------------------------------------------
# Third-party code is never committed: every external source is downloaded
# and hash-verified at build time (docker/Dockerfile, deps/). Only this
# project's own code and its patches live in the repository.
# ---------------------------------------------------------------------------
/vendor/
/third_party/
*.zip
*.tar
*.tar.gz
*.tgz
*.tar.xz
*.tar.bz2
*.whl

# Binaries - the only artifact is built into .bin/
*.com
*.exe
*.elf
*.dbg
*.o
*.a
*.so
*.dylib
*.dll
*.pyd

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Patch tooling leftovers
*.orig
*.rej

# Editors and OS
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# Claude Code session state
/.claude/
