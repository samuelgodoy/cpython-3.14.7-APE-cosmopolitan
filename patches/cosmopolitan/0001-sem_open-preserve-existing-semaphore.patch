--- a/libc/thread/sem_open.c
+++ b/libc/thread/sem_open.c
@@ -1,3 +1,18 @@
+// cpython-cosmo override of Cosmopolitan 4.0.2's libc/thread/sem_open.c.
+//
+// Compiled into python.com so the static linker resolves sem_open,
+// sem_close and sem_unlink to these definitions instead of the prebuilt
+// libc.a member. All three are overridden together because they share
+// the private bookkeeping in this file (g_semaphores).
+//
+// The only behavioural changes are the two marked "cpython-cosmo" below;
+// everything else is upstream verbatim. See BUILD.md, "The named-semaphore
+// bug behind spawn and forkserver".
+
+// Upstream compiles libc with _COSMO_SOURCE and C23 (where bool is a
+// keyword); both are needed here to build this file outside that tree.
+#define _COSMO_SOURCE
+#include <stdbool.h>
 /*-*- mode:c;indent-tabs-mode:nil;c-basic-offset:2;tab-width:8;coding:utf-8 -*-│
 │ vi: set et ft=c ts=2 sts=2 sw=2 fenc=utf-8                               :vi │
 ╞══════════════════════════════════════════════════════════════════════════════╡
@@ -86,17 +101,26 @@
     return SEM_FAILED;
   }
   npassert(!fstat(fd, &st));
-  if (st.st_size < 4096 && ftruncate(fd, 4096) == -1) {
+  // cpython-cosmo: a backing file shorter than one page was just created
+  // by this call (sem_open never leaves one that size behind). Only then
+  // may the semaphore be initialized. Upstream initialized it on EVERY
+  // open, so a second process calling sem_open(name, 0) to reconnect
+  // overwrote the live count - with an unpassed variadic argument, i.e.
+  // stack garbage - corrupting the semaphore for its owner as well.
+  bool created = st.st_size < 4096;
+  if (created && ftruncate(fd, 4096) == -1) {
     npassert(!close(fd));
     return SEM_FAILED;
   }
   sem = mmap(0, 4096, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
   if (sem != MAP_FAILED) {
-    atomic_store_explicit(&sem->sem_value, value, memory_order_relaxed);
-    sem->sem_magic = SEM_MAGIC_NAMED;
-    sem->sem_dev = st.st_dev;
-    sem->sem_ino = st.st_ino;
-    sem->sem_pshared = true;
+    if (created) {
+      atomic_store_explicit(&sem->sem_value, value, memory_order_relaxed);
+      sem->sem_magic = SEM_MAGIC_NAMED;
+      sem->sem_dev = st.st_dev;
+      sem->sem_ino = st.st_ino;
+      sem->sem_pshared = true;
+    }
   } else {
     sem = SEM_FAILED;
   }
@@ -179,10 +203,15 @@
   struct Semaphore *s;
   unsigned mode = 0, value = 0;
 
-  va_start(va, oflag);
-  mode = va_arg(va, unsigned);
-  value = va_arg(va, unsigned);
-  va_end(va);
+  // cpython-cosmo: mode and value are only passed with O_CREAT. Reading
+  // them unconditionally (as upstream does) is undefined behaviour and
+  // yields whatever is on the stack for a plain sem_open(name, 0).
+  if (oflag & O_CREAT) {
+    va_start(va, oflag);
+    mode = va_arg(va, unsigned);
+    value = va_arg(va, unsigned);
+    va_end(va);
+  }
 
